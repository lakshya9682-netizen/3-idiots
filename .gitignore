lor)"},{"id":"weather-dashboard-app","message":"Develop a weather dashboard that fetches data from a public weather API.","titleHtml":"Develop a weather dashboard","icon":"code","color":"var(--display-gray-fgColor)"},{"id":"create-joke-generator","message":"Create a random joke generator using an external API.","titleHtml":"Create a joke generator","icon":"code","color":"var(--display-gray-fgColor)"}]}],"mcpPermissionGateEnabled":true,"spark":{"icebreakers":[{"type":"functional","data":[{"id":"family-calendar","message":"Create a family calendar app to keep track of family events","titleHtml":"Family calendar","icon":"calendar","color":"var(--fgColor-sponsors)"},{"id":"to-do-list-app","message":"Create a to-do list app where users can add tasks, mark them complete, and organize them into categories.","titleHtml":"To-do list app","icon":"checkbox","color":"var(--fgColor-link)"},{"id":"json-to-csv-converter","message":"Build a web app that converts JSON files to CSV format with file upload and download functionality.","titleHtml":"JSON to CSV converter","icon":"arrow-switch","color":"var(--fgColor-severe)"},{"id":"board-game-score-tracker","message":"Create an app to track scores for multiple players across different board games and save game history.","titleHtml":"Board game score tracker","icon":"number","color":"var(--fgColor-done)"},{"id":"media-rating-tracker","message":"Build an app where users can rate and review movies, books, and podcasts they've consumed.","titleHtml":"Media rating tracker","icon":"file-media","color":"var(--fgColor-done)"},{"id":"meal-and-grocery-planner","message":"Create an app for planning weekly meals and generating grocery shopping lists from those meals.","titleHtml":"Meal and grocery planner","icon":"book","color":"var(--fgColor-success)"},{"id":"expense-tracking-app","message":"Build a simple finance tracker for logging expenses, setting budgets, and viewing spending trends.","titleHtml":"Expense tracking app","icon":"credit-card","