app.<span class="hljs-title function_" node="[object Object]">get</span>(<span class="hljs-string" node="[object Object]">"/api/reviews"</span>, <span class="hljs-function" node="[object Object]">(<span class="hljs-params" node="[object Object]">req, res</span>) =&gt;</span> {
